# Token d'intégration Notion (Settings > Connections > Develop or manage integrations)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de la base de données Notion cible (32 caractères dans l'URL de la page)
# Ex: https://www.notion.so/MonEspace/abc123def456... → abc123def456...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nombre de jours en arrière pour la collecte (défaut : 7)
LOOKBACK_DAYS=7

# Score minimum pour publier un article (0 = tous les articles avec au moins 1 mot-clé)
MIN_SCORE=1

# Email — expéditeur Gmail
EMAIL_SENDER=ton.adresse@gmail.com
# Mot de passe d'application Gmail (pas ton mot de passe principal)
# Générer sur : myaccount.google.com → Sécurité → Mots de passe des applications
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
# Destinataires (séparés par des virgules)
EMAIL_RECIPIENTS=mikael.jayet@optimmo-energies.com
